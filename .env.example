# ---------------------------------------------------------------
# .env.example — Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it is in .gitignore).
# ---------------------------------------------------------------

# MCP Server URL used by UI + orchestrator for tool calls
SERVER_URL=http://127.0.0.1:8000

# Local Ollama endpoint (default shown)
# Keep /v1 for OpenAI-compatible routing used by langchain_openai.ChatOpenAI
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional OpenRouter API key (only needed if selecting OpenRouter models)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
